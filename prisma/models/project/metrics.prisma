enum MetricRenderModes {
    Events
    Counts
}

model Metric {
    id Int @id @default(autoincrement())
    title String
    description String @default("")
    ingestKey String @unique
    renderMode MetricRenderModes @default(Counts)

    project Project @relation(fields: [projectId], references: [id])
    projectId Int

    points MetricPoint[]

    @@unique([projectId, title])
}

model MetricPoint {
    id Int @id @default(autoincrement())
    date DateTime
    data String? @default("")
    customization String? @default("")
    
    metricId Int
    metric Metric @relation(fields: [metricId], references: [id])

    @@unique([metricId, date])
}