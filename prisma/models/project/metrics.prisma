model Metric {
    id Int @id @default(autoincrement())
    title String
    description String

    project Project @relation(fields: [projectId], references: [id])
    projectId Int

    points MetricPoint[]

    @@unique([projectId, title])
}

model MetricPoint {
    id Int @id @default(autoincrement())
    timestamp DateTime
    data String
    
    metricId Int
    metric Metric @relation(fields: [metricId], references: [id])

    @@unique([metricId, timestamp])
}